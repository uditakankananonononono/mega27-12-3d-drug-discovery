ndim=3			# number of dimensions in the field
dim1=65			# number of x-elements
dim2=65			# number of y-elements
dim3=65			# number of z-elements
nspace=3		# number of physical coordinates per point
veclen=17		# number of affinity values at each point
data=float		# data type (byte, integer, float, double)
field=uniform		# field type (uniform, rectilinear, irregular)
coord 1 file=7c6s_rec_rigid.maps.xyz filetype=ascii offset=0
coord 2 file=7c6s_rec_rigid.maps.xyz filetype=ascii offset=2
coord 3 file=7c6s_rec_rigid.maps.xyz filetype=ascii offset=4
